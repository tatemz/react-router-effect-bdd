{
  "name": "react-router-effect-bdd",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "version": "0.1.0",
  "description": "Minimal React Router (framework mode) server driven by an Effect pipeline, tested with effect-bdd.",
  "scripts": {
    "build": "react-router build",
    "dev": "MODE=development PORT=3456 LANGUAGE=en node main.ts",
    "dev:rr": "MODE=development PORT=3456 LANGUAGE=en node main.rr.ts",
    "dev:api": "PORT=3457 LANGUAGE=en node main.api.ts",
    "start": "MODE=production PORT=3456 LANGUAGE=en node main.ts",
    "start:rr": "MODE=production PORT=3456 LANGUAGE=en node main.rr.ts",
    "start:api": "PORT=3457 LANGUAGE=en node main.api.ts",
    "pretest-bdd": "react-router build",
    "test-bdd": "NODE_OPTIONS=\"--import tsx\" effect-bdd --features \"features/**/*.feature\" --steps \"features/**/*.steps.ts\" --reporter text --verbose --strict --parallel=2",
    "prepare": "effect-tsgo patch --typescript --no-oxlint",
    "typecheck": "react-router typegen && tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.117",
    "@react-router/node": "^8.4.0",
    "effect": "4.0.0-rc.117",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "isbot": "^5"
  },
  "devDependencies": {
    "@effect/tsgo": "0.46.1",
    "@react-router/dev": "^8.4.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "effect-bdd": "^0.9.3",
    "playwright": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "vite": "^8.0.3"
  }
}
